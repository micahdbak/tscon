{
	"name": "@micahdb/tscon",
	"version": "0.4.2",
	"description": "WebGL 2.0 text-mode graphics in TypeScript.",
	"keywords": [
		"webgl",
		"webgl2",
		"text-mode",
		"terminal",
		"console",
		"cp437",
		"typography",
		"canvas",
		"pi-package",
		"agent-skills"
	],
	"license": "MIT",
	"author": "Micah Baker",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/micahdbak/tscon.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"skills"
	],
	"sideEffects": false,
	"scripts": {
		"lint": "oxlint src scripts",
		"shaders": "bun run scripts/shaders.ts",
		"build": "tsc -p tsconfig.json",
		"prepack": "bun run build",
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"oxlint": "^1.88.0",
		"typescript": "^7.0.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
