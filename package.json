{
	"name": "@micahdb/tscon",
	"version": "0.1.0",
	"description": "WebGL 2.0 text-mode graphics in TypeScript.",
	"license": "MIT",
	"author": "Micah Baker",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/micahdbak/tscon.git"
	},
	"keywords": [
		"webgl",
		"webgl2",
		"text-mode",
		"terminal",
		"console",
		"cp437",
		"typography",
		"canvas"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"lint": "oxlint src scripts",
		"shaders": "bun run scripts/shaders.ts",
		"build": "tsc -p tsconfig.json",
		"prepack": "bun run build"
	},
	"devDependencies": {
		"oxlint": "^1.88.0",
		"typescript": "^7.0.2"
	}
}
